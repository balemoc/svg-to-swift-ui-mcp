{
  "name": "@balemoc/svg-to-swift-ui-mcp",
  "version": "0.1.0",
  "exports": "./src/index.ts",
  "publish": {
    "include": ["README.md", "LICENSE", "deno.json", "src/**/*.ts"]
  },
  "imports": {
    "@modelcontextprotocol/server": "npm:@modelcontextprotocol/server@2.1.0",
    "@modelcontextprotocol/client": "npm:@modelcontextprotocol/client@2.1.0",
    "@modelcontextprotocol/hono": "npm:@modelcontextprotocol/hono@2.0.1",
    "@valibot/to-json-schema": "npm:@valibot/to-json-schema@1.8.0",
    "hono": "npm:hono@4.13.9",
    "svg-to-swiftui-core": "npm:svg-to-swiftui-core@0.4.0",
    "valibot": "npm:valibot@1.5.0"
  },
  "tasks": {
    "start": "deno run --env-file=.env --allow-net --allow-env=HOST,PORT src/index.ts",
    "check": "deno check src/index.ts tests/ && deno fmt --check && deno lint",
    "test": "deno test --allow-net=127.0.0.1 --allow-env=HOST,PORT tests/"
  },
  "fmt": {
    "lineWidth": 100
  }
}
